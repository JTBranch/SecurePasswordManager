# Ignore secrets file
secrets.json
secrets_key_metadata.json
device_keys.json

# Ignore environment files (except .env.example)
.env
.env.*
!.env.example

# Ignore temporary build and CI output files
tmp/
bin/
.gomodcache/
.gopath/
.tools/

.DS_Store
# Ignore backup files
*.backup
*.bak
*.orig

# Ignore application configuration files (runtime generated)
*.config
app.config

# Ignore encryption keys
keys/
.default-key
*.key

# Ignore documentation files that are temporary or generated
*_STRATEGY.md
*_COMPLETE.md
*_PLAN.md
*_IMPLEMENTATION.md

# Ignore compiled binaries
main
/main

# Ignore build artifacts and distribution files
dist/
fyne-cross/
bin/

# Ignore test and debug files  
test_*.sh
*_test_*.sh
test_macos_*.sh

# Ignore local development files
*.local
local-*
.vscode.gomodcache/cache/
